#!/usr/bin/env bats
load helpers

setup() { setup_workspace; }

@test "dry-run: a thread goes to the outbox with the marker, nothing is sent" {
  run bash "$S/post.sh" thread svc-a 101 "$(body_file "Verdict: approved")"
  [ "$status" -eq 0 ]
  [ "$(jq -r .mode <<<"$output")" = "dry-run" ]
  f=$(jq -r .outbox <<<"$output")
  [[ "$(jq -r '.body.comments[0].content' "$f")" == "<!-- pr-review:test -->"* ]]
  [ ! -s "$CURL_LOG" ]
}

@test "a reply uses a bare comment object, not the thread wrapper" {
  run bash "$S/post.sh" reply svc-a 101 900 "$(body_file "Re-review")"
  [ "$status" -eq 0 ]
  f=$(jq -r .outbox <<<"$output")
  jq -e '.body | has("parentCommentId") and has("content") and (has("comments") | not)' "$f"
}

@test "-10 is never cast" {
  run bash "$S/post.sh" vote svc-a 101 -10
  [ "$status" -eq 2 ]
  [[ "$output" == *"never used"* ]]
}

@test "+5 is refused with the strict profile" {
  run bash "$S/post.sh" vote svc-a 101 5
  [ "$status" -eq 2 ]
}

@test "a Draft PR only takes vote 0" {
  run bash "$S/post.sh" vote svc-a 102 10
  [ "$status" -eq 2 ]
  [[ "$output" == *"Draft"* ]]
  run bash "$S/post.sh" add-required svc-a 102
  [ "$status" -eq 0 ]
}

@test "no vote on a self-authored PR" {
  run bash "$S/post.sh" vote svc-a 103 10
  [ "$status" -eq 6 ]
}

@test "content that says the review is generated is refused" {
  run bash "$S/post.sh" thread svc-a 101 "$(body_file "This review was generated by Claude.")"
  [ "$status" -eq 4 ]
}

@test "a moved source tip blocks the post" {
  run bash "$S/post.sh" thread svc-a 101 "$(body_file "Verdict")" --expect-tip aaaa1111
  [ "$status" -eq 3 ]
  run bash "$S/post.sh" thread svc-a 101 "$(body_file "Verdict")" --expect-tip bbbb2222
  [ "$status" -eq 0 ]
}

@test "comment mode posts comments but keeps votes in the outbox" {
  sed -i 's|^POST_MODE=.*|POST_MODE="comment"|' "$WS/config.env"
  run bash "$S/post.sh" thread svc-a 101 "$(body_file "Verdict")"
  [ "$status" -eq 0 ]
  [ "$(jq -r .mode <<<"$output")" = "live" ]
  grep -q '^POST .*/threads' "$CURL_LOG"
  run bash "$S/post.sh" vote svc-a 101 -5
  [ "$(jq -r .mode <<<"$output")" = "dry-run" ]
  ! grep -q '^PUT' "$CURL_LOG"
}

@test "comment+vote casts the vote as required and logs it in the ledger" {
  sed -i 's|^POST_MODE=.*|POST_MODE="comment+vote"|' "$WS/config.env"
  run bash "$S/post.sh" vote svc-a 101 -5
  grep -q '^PUT .*/reviewers/me-0001?api-version=7.0 {"vote":-5,"isRequired":true}$' "$CURL_LOG"
  [ "$(jq -r .tip "$WS/state/votes.jsonl")" = "bbbb2222" ]
  # the fake server still answers +10: the read-back must flag the mismatch
  [ "$(jq -r .ok <<<"$output")" = "false" ]
  [ "$(jq -r .live.vote <<<"$output")" = "10" ]
}
