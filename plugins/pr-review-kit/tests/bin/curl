#!/usr/bin/env bash
# Fake curl for the tests: serves JSON fixtures by URL and records every non-GET call
# in $CURL_LOG. No network access. Supports -X, -d, -o, -w '%{http_code}', -u, -H, -s, -m.
method=GET; data=""; out=""; wfmt=""; url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -X) method=$2; shift 2 ;;
    -d|--data) data=$2; method=${method/GET/POST}; shift 2 ;;
    -o) out=$2; shift 2 ;;
    -w) wfmt=$2; shift 2 ;;
    -H|-u|-m|--max-time|--retry) shift 2 ;;
    http*) url=$1; shift ;;
    *) shift ;;
  esac
done
F="$FIXTURES"
body='{}'; code=200
case "$url" in
  *connectionData*)                    body=$(cat "$F/connection.json") ;;
  *"/pullRequests/"*"/iterations/"*"/changes"*) body='{"changeEntries":[]}' ;;
  *"/pullRequests/"*"/iterations"*)    id=$(sed -E 's#.*/pullRequests/([0-9]+)/.*#\1#' <<<"$url"); body=$(cat "$F/iterations-$id.json" 2>/dev/null || cat "$F/iterations.json") ;;
  *"/pullRequests/"*"/threads/"*"/comments"*) body='{"id":7}' ;;
  *"/pullRequests/"*"/threads/"*)      body='{"id":55,"comments":[{"id":1,"parentCommentId":0}]}' ;;
  *"/pullRequests/"*"/threads"*)       if [ "$method" = GET ]; then id=$(sed -E 's#.*/pullRequests/([0-9]+)/.*#\1#' <<<"$url"); body=$(cat "$F/threads-$id.json" 2>/dev/null || echo '{"value":[]}'); else body='{"id":42}'; fi ;;
  *"/pullRequests/"*"/reviewers/"*)    body='{"id":"me","vote":-5}' ;;
  *"/pullRequests/"*)                  id=$(sed -E 's#.*/pullRequests/([0-9]+).*#\1#' <<<"$url"); body=$(cat "$F/pr-$id.json") ;;
  *"/pullrequests?"*)                  body=$(cat "$F/prlist.json") ;;
  *) code=404; body='{"message":"not found"}' ;;
esac
[ "$method" != GET ] && printf '%s %s %s\n' "$method" "$url" "$data" >> "${CURL_LOG:-/dev/null}"
if [ -n "$out" ]; then printf '%s' "$body" > "$out"; else printf '%s' "$body"; fi
[ "$wfmt" = '%{http_code}' ] && printf '%s' "$code"
exit 0
