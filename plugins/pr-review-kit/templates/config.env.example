# =============================================================================
# pr-review-kit — team configuration (config.env)
# =============================================================================
# Shell-sourceable KEY=VALUE file, one per team workspace. Every team-specific value
# lives here; the kit's scripts and skills contain none. Secrets are NEVER stored in
# this file — only in the environment (see the end of the file).
# Quote values that contain spaces or special characters.
# -----------------------------------------------------------------------------

# ---- Azure DevOps target (required) -----------------------------------------
ADO_ORG="my-org"                 # https://dev.azure.com/<ADO_ORG>
ADO_PROJECT="MyProject"
ADO_API_VERSION="7.0"

# ---- Scope -------------------------------------------------------------------
REPO_ALLOWLIST_FILE="repos.allowlist"   # relative to the workspace; one repo per line
EXCLUDED_PRS=""                         # PR ids the loop must never touch, space-separated

# Team reviewer group: PRs where this group is a reviewer are always picked up and the
# reviewer identity is added as a REQUIRED reviewer. Empty = disabled.
TEAM_GROUP_ID=""
TEAM_NAME=""

# Repository kinds (space-separated repo names). Anything not listed = back-end service.
SQL_REPOS=""          # migration repositories, reviewed against their own procedure docs
LIBRARY_REPOS=""      # shared libraries / starters: no unit-test COVERAGE rule
FRONT_REPOS=""        # front-end portals: exempt from the unit-test rule, no scanners
SQL_PROCEDURE_DOCS="/README.md /MIGRATIONS.md"   # procedure files read at the PR source commit

# ---- Review policy -------------------------------------------------------------
TICKET_KEY_REGEX='(ABC|XYZ)-[0-9]+'   # ticket keys accepted in PR titles / branches
REVIEW_LANGUAGE="en"                  # language of posted reviews: en | fr | …
POLICY_PROFILE="strict"               # strict: any point → −5 · standard: only 🔴/🟠 block, 🟡 → +5
UNIT_TESTS_BLOCKING="true"            # back-end logic without unit tests is a 🟠 point
SCANNERS="semgrep trivy mvn"          # tools to run when installed; remove one to skip it
SEMGREP_CONFIG="p/default"

# Idempotency marker that starts every posted comment. MUST be unique to this team:
# several review loops share Azure DevOps, and comments are matched on marker AND author.
PR_MARKER="<!-- pr-review:myteam -->"
PR_MARKER_ALIASES=""                  # older markers still recognised, '|'-separated

# Posting mode — start in dry-run, move up once the team owner signs off:
#   dry-run       reviews are written locally, nothing is posted (payloads in state/outbox/)
#   comment       comments are posted, votes are not
#   comment+vote  comments and votes are posted
POST_MODE="dry-run"

# ---- Review loop ---------------------------------------------------------------
REVIEW_PARALLEL_AGENTS="1"            # PRs reviewed in parallel by the loop (1 = one after another)
REVIEW_AGENT_MODEL=""                 # model for per-PR review agents (empty = session model)

# ---- Workspace layout (defaults shown) ----------------------------------------------
# REVIEWS_DIR="$PRR_WORKSPACE/reviews"     # review files: <REVIEWS_DIR>/<TICKET>/<YYYY-MM-DD>/<prefix>N-PR-<id>.md
# REVIEW_FILE_PREFIX="review"
# HISTORY_FILE="$PRR_WORKSPACE/history.md"
# STATE_DIR="$PRR_WORKSPACE/state"

# ---- Jira (optional — empty JIRA_BASE disables every Jira call) ---------------------
JIRA_BASE=""                          # e.g. https://my-company.atlassian.net
JIRA_EMAIL=""                         # account of JIRA_PAT
JIRA_SUBTASK_TYPES=""                 # merge-deploy only: "PROJ=<sub-task issue type id> …"

# ---- Waiting-for-author reminder (optional) ----------------------------------
WFA_MENTION="<users/all>"             # Chat mention on the card; empty = no ping
WFA_TITLE=""                          # optional card title; empty = built-in text for REVIEW_LANGUAGE (en | fr)
WFA_SUBTITLE=""                       # optional card subtitle; {n} = number of PRs
WFA_NO_TICKET=""                      # optional label for PRs without a ticket

# ---- Merge and deploy module (optional) ----------------------------------------
MERGE_ALLOW_BYPASS="false"            # bypass "more approvers" branch policies when completing
MERGE_BYPASS_REASON=""
MERGE_DELETE_SOURCE_BRANCH="false"
MERGE_COMMIT_TRAILER=""               # extra line appended to cherry-pick commit messages
RELEASE_BRANCH_PATTERN="release/*"    # semver release branches; carry-overs go to every later one, then DEFAULT_BRANCH
DEFAULT_BRANCH="develop"
DEFAULT_RELEASE_REF=""                # default ref for check-pr-deployed.sh
DEPLOY_ENVIRONMENTS=""                # e.g. "test staging production"
DEPLOY_DEFAULT_ENV=""
DEPLOY_LIBRARY_GROUPS=""              # "env=variableGroup …" — CI_BRANCH of the group = default branch
PRODUCTION_ENVS="production"          # need --confirm-production; the merge-deploy skill never deploys there
# DEPLOY_PIPELINES_FILE="$PRR_WORKSPACE/pipelines.map"
# GIT_AUTHOR_NAME="" GIT_AUTHOR_EMAIL=""   # identity of cherry-pick commits (default: git config)

# ---- Secrets: environment variables only (never in this file) -----------------
#   AZURE_DEVOPS_PAT        review identity: Code (Read), Pull Request Threads (Read & Write);
#                           votes need "Contribute to pull requests" on the repositories
#   AZURE_DEVOPS_MERGE_PAT  merge-deploy only: Code (Read & Write), Build (Read & Execute)
#   JIRA_PAT                Jira API token of JIRA_EMAIL
#   GCHAT_WEBHOOK_URL       Google Chat incoming webhook (contains a secret token)
