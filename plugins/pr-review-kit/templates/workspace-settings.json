{
  "permissions": {
    "allow": [
      "Bash(bash:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(git:*)",
      "Bash(diff:*)",
      "Bash(date:*)",
      "Bash(mkdir:*)",
      "Read",
      "Write",
      "Edit"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
