{
  "permissions": {
    "allow": [
      "Bash(jq *)",
      "Bash(date *)",
      "Read(~/.claude/plugins/cache/pr-review-tools/pr-review-kit/**)",
      "Edit(/reviews/**)",
      "Edit(/state/**)",
      "Edit(/history.md)"
    ],
    "deny": [
      "Bash(*/../*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(git push *)",
      "Bash(* | sh*)",
      "Bash(* | bash*)",
      "Edit(/.claude/**)",
      "Edit(/config.env)",
      "Edit(/repos.allowlist)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/.m2/settings*.xml)"
    ]
  }
}
