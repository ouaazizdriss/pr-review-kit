{
  "permissions": {
    "allow": [
      "Read(~/.claude/plugins/cache/pr-review-tools/pr-review-kit/**)",
      "Edit(/reviews/**)",
      "Edit(/state/**)",
      "Edit(/history.md)"
    ],
    "deny": [
      "Bash(*/../*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(* | sh*)",
      "Bash(* | bash*)",
      "Edit(/repos.allowlist)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/.m2/settings*.xml)",
      "Bash(env*)",
      "Bash(printenv*)",
      "Bash(git *)",
      "Edit(**/config.env)",
      "Edit(**/.claude/**)",
      "Edit(~/.local/state/**)",
      "Edit(~/.config/**)",
      "Edit(~/.claude/**)"
    ]
  }
}
